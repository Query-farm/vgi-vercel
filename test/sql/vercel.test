# name: test/sql/vercel.test
# description: SQL tests for the vercel worker against the strict offline Vercel replay server (test/mock_api/server.py)
# group: [vercel]

require vgi

require-env VERCEL_WORKER

require-env VERCEL_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'vercel' (TYPE vgi, LOCATION '{VERCEL_WORKER}');

# Every pushdown check below compares the FIRST request a query sent after this mark.
statement ok
CREATE MACRO mark() AS TABLE SELECT coalesce(max(seq), 0) AS s FROM read_json('{VERCEL_FIXTURE_URL}/__requests?prefix=/');

statement ok
CREATE MACRO reqs(p, since_seq) AS TABLE
  SELECT seq, query FROM read_json('{VERCEL_FIXTURE_URL}/__requests?path=' || p) WHERE seq > since_seq ORDER BY seq;

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM vercel.main.projects;
----
<REGEX>:.*no vercel secret.*

statement ok
CREATE SECRET v_bad (TYPE vercel, TOKEN 'wrong-token', TEAM_ID 'team_acme', BASE_URL '{VERCEL_FIXTURE_URL}');

statement error
SELECT count(*) FROM vercel.main.deployments;
----
<REGEX>:.*HTTP 403.*forbidden.*

statement ok
DROP SECRET v_bad;

statement ok
CREATE SECRET v_insecure (TYPE vercel, TOKEN 'x', BASE_URL 'http://api.vercel.com');

statement error
SELECT count(*) FROM vercel.main.deployments;
----
<REGEX>:.*https.*

statement ok
DROP SECRET v_insecure;

statement ok
CREATE SECRET v_both (TYPE vercel, TOKEN 'test-token', TEAM_ID 'team_acme', TEAM_SLUG 'acme', BASE_URL '{VERCEL_FIXTURE_URL}');

statement error
SELECT count(*) FROM vercel.main.deployments;
----
<REGEX>:.*TEAM_ID or TEAM_SLUG.*

statement ok
DROP SECRET v_both;

# ------------------------------------------------------------------ team scope

# No team: the personal account (empty in the fixture), and no team parameter sent.
statement ok
CREATE SECRET v_personal (TYPE vercel, TOKEN 'test-token', BASE_URL '{VERCEL_FIXTURE_URL}');

statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query I
SELECT count(*) FROM vercel.main.deployments;
----
0

query T
SELECT query FROM reqs('/v6/deployments', (SELECT s FROM m)) LIMIT 1;
----
{"limit": "100"}

# team_members needs a team id.
statement error
SELECT count(*) FROM vercel.main.team_members;
----
<REGEX>:.*TEAM_ID.*

statement ok
DROP SECRET v_personal;

# TEAM_SLUG adds slug=.
statement ok
CREATE SECRET v_slug (TYPE vercel, TOKEN 'test-token', TEAM_SLUG 'acme', BASE_URL '{VERCEL_FIXTURE_URL}');

statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query I
SELECT count(*) FROM vercel.main.deployments;
----
8

query T
SELECT query FROM reqs('/v6/deployments', (SELECT s FROM m)) LIMIT 1;
----
{"limit": "100", "slug": "acme"}

statement ok
DROP SECRET v_slug;

statement ok
CREATE SECRET v_fixture (TYPE vercel, TOKEN 'test-token', TEAM_ID 'team_acme', BASE_URL '{VERCEL_FIXTURE_URL}');

# ------------------------------------------------------------------------ teams

# /v2/teams is not team-scoped: no teamId is sent.
statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query TTTT
SELECT id, slug, name, role FROM vercel.main.teams ORDER BY id;
----
team_acme	acme	Acme	OWNER
team_side	side-project	Side Project	MEMBER

query T
SELECT query FROM reqs('/v2/teams', (SELECT s FROM m)) LIMIT 1;
----
{"limit": "100"}

# --------------------------------------------------------------------- projects

# The first /v10/projects request is answered 429 + Retry-After; the scan retries.
query TTTTTTT
SELECT platform, id, name, framework, repo, repo_provider, production_branch FROM vercel.main.projects ORDER BY id;
----
vercel	prj_api	api	NULL	acme/api	gitlab	trunk
vercel	prj_docs	docs	astro	acme/docs	github	main
vercel	prj_web	web	nextjs	acme/web	github	main

query TTTTT
SELECT name, node_version, root_directory, build_command, production_url FROM vercel.main.projects ORDER BY name;
----
api	18.x	NULL	NULL	https://api-api1-acme.vercel.app
docs	20.x	site	pnpm build	https://docs.acme.com
web	22.x	NULL	NULL	https://web.acme.com

statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query T
SELECT id FROM vercel.main.projects WHERE name = 'docs';
----
prj_docs

query T
SELECT query FROM reqs('/v10/projects', (SELECT s FROM m)) LIMIT 1;
----
{"limit": "100", "search": "docs", "teamId": "team_acme"}

