# ------------------------------------------------------------- activity events

# page_size := 2 walks back with until = oldest + 1 ms (safe whether Vercel's `until` is
# inclusive or exclusive); the boundary event is re-read and skipped by id, so each page
# after the first adds one new event: 7 requests for 7 events, none duplicated.
statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query II
SELECT count(*), count(DISTINCT id) FROM vercel.main.activity_events(page_size := 2);
----
7	7

query I
SELECT count(*) FROM reqs('/v3/events', (SELECT s FROM m));
----
7

statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query TTT
SELECT id, username, text FROM vercel.main.activity_events() WHERE type = 'project-env-variable' AND created_at >= TIMESTAMPTZ '2026-10-01 00:00:00+00' ORDER BY created_at;
----
evt_2	ada	ada added DATABASE_URL to web
evt_4	grace	grace updated FEATURE_LOGIN in web
evt_7	ada	ada removed OLD_KEY from api

query T
SELECT query FROM reqs('/v3/events', (SELECT s FROM m)) LIMIT 1;
----
{"limit": "100", "since": "2026-09-30T23:59:59.999Z", "teamId": "team_acme", "types": "project-env-variable"}

