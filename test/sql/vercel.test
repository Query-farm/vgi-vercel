# created_at ranges → since/until (widened by 1 ms; the SDK re-applies the exact bounds).
statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query T
SELECT id FROM vercel.main.deployments WHERE created_at >= TIMESTAMPTZ '2026-11-02 10:00:00+00' AND created_at < TIMESTAMPTZ '2026-11-04 10:00:00+00' ORDER BY id;
----
dpl_web2
dpl_web3

query T
SELECT query FROM reqs('/v6/deployments', (SELECT s FROM m)) LIMIT 1;
----
{"limit": "100", "since": "1793613599999", "teamId": "team_acme", "until": "1793786400001"}

# A predicate under OR is not pushed (only re-applied), so no rows are lost.
statement ok
CREATE OR REPLACE TEMP TABLE m AS SELECT * FROM mark();

query T
SELECT id FROM vercel.main.deployments WHERE project = 'docs' OR state = 'building' ORDER BY id;
----
dpl_api1
dpl_docs1
dpl_docs2

query T
SELECT query FROM reqs('/v6/deployments', (SELECT s FROM m)) LIMIT 1;
----
{"limit": "100", "teamId": "team_acme"}

