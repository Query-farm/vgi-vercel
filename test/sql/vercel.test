# --------------------------------------------------------- env var names

query TTTTT
SELECT project, key, targets, type, git_branch FROM vercel.main.env_var_names ORDER BY project, key;
----
docs	ALGOLIA_APP_ID	[production, preview, development]	plain	NULL
web	ANALYTICS_ID	[production]	plain	NULL
web	DATABASE_URL	[production, preview]	encrypted	NULL
web	FEATURE_LOGIN	[preview]	plain	feature/login
web	NEXT_PUBLIC_SITE_URL	[production]	plain	NULL
web	STRIPE_SECRET_KEY	[production]	sensitive	NULL

# Values never leave the worker: no value column, and no fixture value appears in any row.
query I
SELECT count(*) FROM (DESCRIBE vercel.main.env_var_names) WHERE column_name ILIKE '%value%' OR column_name ILIKE '%decrypt%';
----
0

query I
SELECT count(*) FROM (SELECT to_json(e)::VARCHAR AS j FROM vercel.main.env_var_names e) WHERE j ILIKE '%s3cr3t%' OR j LIKE '%web.acme.com%';
----
0

# Requests never asked for decryption (the replay server would 400 on `decrypt`).
query I
SELECT count(*) FROM read_json('{VERCEL_FIXTURE_URL}/__requests?prefix=/v10/projects/') WHERE query LIKE '%decrypt%';
----
0

query TI
SELECT project, count(*) FROM vercel.main.env_var_names WHERE project_id = 'prj_web' AND list_contains(targets, 'production') GROUP BY project;
----
web	4

